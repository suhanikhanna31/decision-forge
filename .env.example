# Shared secret used by auth-service to sign JWTs, and by ml-service /
# audit-service to verify them locally. Must match across all three.
DJANGO_SECRET_KEY=change-me-in-production

# Shared key ml-service uses to authenticate its internal writes to
# audit-service (POST /api/logs), separate from user JWTs.
INTERNAL_SERVICE_KEY=change-me-too
